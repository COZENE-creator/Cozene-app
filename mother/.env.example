# Copy to .env.local and fill in. .env.local is git-ignored.

# --- Database ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cozene
# Set to "require" for managed Postgres that needs TLS (Supabase/Neon/RDS).
PGSSL=

# --- LINE Messaging API (server-only; never exposed to the browser) ---
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# --- LINE Mini App (guest login) ---
# Channel ids whose ID tokens the Mini App API accepts (comma-separated): the Mini App
# channel, plus the legacy LIFF channel while both run. LIFF id "1234567890-abcd" → "1234567890".
LINE_LOGIN_CHANNEL_IDS=
# Prefills the Table QR page (Mother → Table QR).
MINIAPP_LIFF_ID=
# Bump when the consent wording in web/miniapp/index.html changes; guests are asked again.
CONSENT_POLICY_VERSION=2026-10
# Local dev only: accept "dev:<userId>" tokens (web/config.js DEV_USER_ID). Never in production.
# LINE_ID_TOKEN_DEV=1

# --- Square ---
SQUARE_ACCESS_TOKEN=
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_ENVIRONMENT=sandbox
# The exact public URL Square is configured to POST to (needed for signature verification).
SQUARE_WEBHOOK_URL=https://your-host/api/webhooks/square

# --- Admin auth (M3) ---
# Comma-separated allowlist of admin emails, and a shared password for the MVP login.
ADMIN_EMAILS=tomoyuki.yasukawa@syscratcho.co.jp
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=generate-a-long-random-string
