{
  "name": "cozene-mother",
  "version": "0.1.0",
  "private": true,
  "description": "Cozene Mother System — admin console + ingest/webhook/push API (Phase 2).",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "db:migrate": "for f in ../db/migrations/*.sql; do psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f \"$f\" || exit 1; done",
    "db:seed": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f ../db/seed.sql"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "next": "14.2.35",
    "pg": "^8.12.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.0",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "typescript": "^5.5.0"
  }
}
